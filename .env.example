# Copy to .env.local for development, and add the same variables in your
# hosting provider (Vercel → Project → Settings → Environment Variables).
# Never commit real values.

# Public URL of the site, without a trailing slash. Used for canonical URLs,
# Open Graph images and the sitemap. Optional on Vercel: production uses the
# project's production domain (custom or .vercel.app) automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Google Search Console ownership check ("HTML tag" method): the
# content="..." value only, not the whole <meta> tag.
GOOGLE_SITE_VERIFICATION=

# ---------------------------------------------------------------- Payload CMS
# Postgres connection string. On Vercel, add a Neon database from the Storage
# tab and this is set for you. Locally, see "Run the CMS locally" in README.md.
# Without it, the site shows the starter content in /content and /admin is off.
DATABASE_URL=

# SERVER ONLY. A long random string that signs admin logins,
# e.g. `openssl rand -hex 32`.
PAYLOAD_SECRET=

# SERVER ONLY. Vercel Blob read/write token for uploaded images. On Vercel,
# add a Blob store from the Storage tab and this is set for you. Leave empty
# locally to save uploads in the /media folder instead.
BLOB_READ_WRITE_TOKEN=
