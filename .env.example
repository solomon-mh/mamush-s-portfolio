# Copy to .env.local for development, and add the same variables in your
# hosting provider (Vercel → Project → Settings → Environment Variables).
# Never commit real values.

# Public URL of the site, without a trailing slash. Used for canonical URLs,
# Open Graph images and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------- Email
# SERVER ONLY. Contact form delivery through Resend (https://resend.com).
# Without these the form explains that messages can't be sent and shows
# the direct email address instead — it never pretends to succeed.
RESEND_API_KEY=
# A sender on a domain you have verified in Resend, e.g. "Portfolio <studio@yourdomain.com>".
CONTACT_FROM_EMAIL=
# Where enquiries are delivered.
CONTACT_TO_EMAIL=
